# from dashboard -> settings -> developer -> oauth apps
CLIENT_ID=oc_...
# leave empty for a public (pkce only) client
CLIENT_SECRET=
# must be registered on the app exactly like this
REDIRECT_URI=http://localhost:3000/callback
# space separated, a subset of what the app is allowed
SCOPES=tts:read tts:control chat:write
PORT=3000
API=https://api.tippage.com
